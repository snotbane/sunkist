[sub_resource type="GDScript" id="GDScript_8rn3i"]
script/source = "@tool
extends Node3D

const DRAG_SPEED: float = 0.01

@onready var in_edited_scene: bool = get_tree().edited_scene_root == owner

var mouse_down: int

func _ready() -> void:
	var svpc : SubViewportContainer
	var cursor = self
	while cursor != null and cursor is not SubViewportContainer:
		cursor = cursor.get_parent()
	if cursor == null:
		return
		
	svpc = cursor
	svpc.gui_input.connect((func(event: InputEvent) -> void:
		if event is InputEventMouseButton:
			match event.button_index:
				MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT:
					mouse_down = 1 if event.is_pressed() else -1

		if mouse_down <= 0: return

		if event is InputEventMouseMotion:
			rotation.y -= event.screen_relative.x * DRAG_SPEED
			rotation.x -= event.screen_relative.y * DRAG_SPEED

	))


func reset() -> void:
	rotation = Vector3.ZERO
	if %sunkist.texture == null:
		return
		
	%sunkist.pixel_size = 1.0 / %sunkist.texture.get_size().y
"

